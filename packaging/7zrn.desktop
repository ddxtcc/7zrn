[Desktop Entry]
Type=Application
Name=7zrn
GenericName=Archive Manager
Comment=Native GPUI archive manager powered by 7-Zip and tar
Exec=sevenzrn %f
TryExec=sevenzrn
Icon=7zrn
Terminal=false
Categories=Utility;Archiving;
Keywords=archive;compress;extract;7z;zip;tar;rar;
MimeType=application/x-7z-compressed;application/zip;application/x-tar;application/gzip;application/x-gzip;application/x-bzip2;application/x-bzip;application/x-xz;application/zstd;application/x-zstd;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-iso9660-image;application/x-cd-image;application/vnd.debian.binary-package;application/x-deb;application/x-rpm;application/x-lzma;application/x-lz4;application/x-archive;application/x-cpio;application/x-msi;application/x-apple-diskimage;application/x-arj;application/x-lzh-compressed;application/x-compressed-tar;application/vnd.ms-cab-compressed;
StartupNotify=true
StartupWMClass=sevenzrn
